# === Rails Backend (rewards-redemption-api) ===

/rewards-redemption-api/.bundle
/rewards-redemption-api/log/*
/rewards-redemption-api/tmp/*
!/rewards-redemption-api/log/.keep
!/rewards-redemption-api/tmp/.keep

/rewards-redemption-api/tmp/pids/*
!/rewards-redemption-api/tmp/pids/
/rewards-redemption-api/tmp/pids/.keep

/rewards-redemption-api/storage/*
!/rewards-redemption-api/storage/.keep
/rewards-redemption-api/tmp/storage/*
!/rewards-redemption-api/tmp/storage/
/rewards-redemption-api/tmp/storage/.keep

/rewards-redemption-api/config/master.key

# Ignore all environment files (except templates).
/rewards-redemption-api/.env*
!/rewards-redemption-api/.env*.erb

# === React Frontend (rewards-redemption-web) ===

/rewards-redemption-web/logs
/rewards-redemption-web/*.log
/rewards-redemption-web/npm-debug.log*
/rewards-redemption-web/yarn-debug.log*
/rewards-redemption-web/yarn-error.log*
/rewards-redemption-web/pnpm-debug.log*
/rewards-redemption-web/lerna-debug.log*

/rewards-redemption-web/node_modules
/rewards-redemption-web/dist
/rewards-redemption-web/dist-ssr
/rewards-redemption-web/*.local

# Editor directories and files
/rewards-redemption-web/.vscode/*
!/rewards-redemption-web/.vscode/extensions.json
/rewards-redemption-web/.idea
/rewards-redemption-web/.DS_Store
/rewards-redemption-web/*.suo
/rewards-redemption-web/*.ntvs*
/rewards-redemption-web/*.njsproj
/rewards-redemption-web/*.sln
/rewards-redemption-web/*.sw?
